# The setup script creates a private .env in /opt/smart-learning-local.
# These defaults apply only to the local VM prototype.
POSTGRES_DB=smart_learning
POSTGRES_USER=smart_learning
POSTGRES_PASSWORD=GENERATED_BY_SETUP
DATABASE_URL=postgresql+psycopg://smart_learning:GENERATED_BY_SETUP@postgres:5432/smart_learning
QDRANT_URL=http://qdrant:6333
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=qwen2.5:0.5b
OLLAMA_THINK_MODE=off
OLLAMA_NUM_THREADS=1
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_EMBED_DIGEST=
QDRANT_COLLECTION_PREFIX=smart_learning_local_chunks
UPLOAD_ROOT=/data/uploads
EMBEDDING_BATCH_SIZE=2
RAG_CITATION_EXAMPLE=true
CHAT_QUEUE_CAPACITY=4
CHAT_QUEUE_WAIT_SECONDS=180
CHAT_GENERATION_SECONDS=210
CHAT_CONTEXT_TOKENS=4096
CHAT_PREDICT_TOKENS=128
APP_ENV=development
APP_ORIGIN=https://smart-learning.test
ALLOWED_ORIGINS=https://smart-learning.test
SESSION_COOKIE_SECURE=true
