# Copy this file to .env before starting the stack.
# Never commit the resulting .env file.

POSTGRES_DB=smart_learning
POSTGRES_USER=smart_learning
POSTGRES_PASSWORD=change-me-before-deployment

DATABASE_URL=postgresql+psycopg://smart_learning:change-me-before-deployment@postgres:5432/smart_learning
QDRANT_URL=http://qdrant:6333
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=gpt-oss:20b
OLLAMA_EMBED_MODEL=nomic-embed-text
# Set to the 64-character digest from Ollama /api/tags after pulling the embedding model.
OLLAMA_EMBED_DIGEST=
QDRANT_COLLECTION_PREFIX=smart_learning_chunks
UPLOAD_ROOT=/data/uploads
MAX_UPLOAD_BYTES=20971520
MAX_PDF_PAGES=500
MAX_PDF_CHARACTERS=2000000
EMBEDDING_BATCH_SIZE=4
RETRIEVAL_LIMIT=8
RETRIEVAL_SCORE_THRESHOLD=0.55
WORKER_LEASE_SECONDS=300
WORKER_MAX_ATTEMPTS=3

# M3: one active generation and at most four admitted requests.
CHAT_QUEUE_CAPACITY=4
CHAT_QUEUE_WAIT_SECONDS=60
CHAT_GENERATION_SECONDS=150
CHAT_HISTORY_MESSAGES=12
CHAT_CONTEXT_TOKENS=4096
CHAT_PREDICT_TOKENS=512

APP_ENV=development
APP_VERSION=0.1.0
APP_ORIGIN=https://smart-learning.test
# Comma-separated exact browser origins. Replace the example before deployment.
ALLOWED_ORIGINS=https://smart-learning.test,http://127.0.0.1:8080,http://localhost:5173
# Keep true when accessed through Tailscale Serve HTTPS.
SESSION_COOKIE_SECURE=true
SESSION_TTL_HOURS=12
# Login limits apply to the single API process, including successful attempts.
LOGIN_ACCOUNT_ATTEMPTS=10
LOGIN_GLOBAL_ATTEMPTS=60
LOGIN_WINDOW_SECONDS=60
LOGIN_MAX_CONCURRENT=2
READINESS_TIMEOUT_SECONDS=2.0
WORKER_POLL_SECONDS=15
